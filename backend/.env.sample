# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
# MongoDB Atlas:  mongodb+srv://<user>:<pass>@cluster.mongodb.net/nexainvest
# Local:          mongodb://127.0.0.1:27017/nexainvest
MONGO_URI=your_mongodb_connection_string

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_long_random_secret_key_at_least_64_chars

# ─── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Optional: set in Razorpay dashboard under Webhooks to verify webhook events
# RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ─── Mailtrap (SMTP sandbox) ──────────────────────────────────────────────────
MAILTRAP_SMTP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_SMTP_PORT=2525
MAILTRAP_SMTP_USER=your_mailtrap_smtp_user
MAILTRAP_SMTP_PASS=your_mailtrap_smtp_pass
MAIL_FROM_NAME=NexaInvest
MAIL_FROM_ADDRESS=noreply@nexainvest.com
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173

# ─── MAILTRAP.IO ─────────────────────────────────────────────────────────────────────
MAILTRAP_SMTP_HOST=SMTP_HOST_NAME
MAILTRAP_SMTP_PORT=SMTP_PORT_NAME
MAILTRAP_SMTP_USER=SMTP_USER_NAME
MAILTRAP_SMTP_PASS=SMTP_PASS_NAME
